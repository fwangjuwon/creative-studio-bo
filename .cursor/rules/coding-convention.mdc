```java
// ❌ JPA/Hibernate 사용 금지
@Entity
@Table(name = "user")
@Column(name = "created_at")

// ❌ createdAt/updatedAt 필드명 사용 금지

// ❌ DB에 FK CONSTRAINT 생성 금지
FOREIGN KEY (user_id) REFERENCES USER(id)

// ❌ category depth 숫자(1/2/3) 사용 금지 — category_type(LCS/MCS/SCS) 사용
```

