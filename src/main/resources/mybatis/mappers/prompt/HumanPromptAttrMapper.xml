<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nsmall.ns_creative_studio_bo.domain.prompt.mapper.HumanPromptAttrMapper">

    <select id="existsByStepId" resultType="boolean">
        SELECT COUNT(*) <![CDATA[ > ]]> 0
        FROM human_prompt_attr
        WHERE step_id = #{stepId}
    </select>

</mapper>
